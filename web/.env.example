# Copy to .env.local. Without Supabase keys the app stores data in .data/dojo.json (dev only).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Long random string used to sign login cookies:  openssl rand -hex 32
SESSION_SECRET=
# Demo OTP: any 6-digit code works (000000 is rejected). Set to 0 to disable once real OTP is wired.
DEMO_OTP=1

# Razorpay (use the TEST keys until you go live). Key Secret and webhook secret are private: never commit or share them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local development only: fake Razorpay so you can test the whole flow without keys (ignored in production).
# RAZORPAY_MOCK=1

# Vercel: set all four variables above in Project Settings -> Environment Variables (Production). Supabase is required in production.

# Phone OTP sign-in with Firebase Authentication (Firebase console -> Project settings -> Your apps -> Web app).
# When these are set the demo OTP is switched off and members receive a real SMS code.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
